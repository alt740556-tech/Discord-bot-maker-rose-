services:
  - type: web
    name: rose-ai
    env: node
    plan: free
    buildCommand: npm install
    startCommand: npm start
    envVars:
      - key: NODE_ENV
        value: production
      - key: BOT_NAME
        value: Rose AI
      - key: BOT_DESCRIPTION
        value: help: Show available commands\nping: Check the bot latency\nstatus: Show bot status
      - key: DISCORD_TOKEN
        sync: false
      - key: DISCORD_CLIENT_ID
        sync: false
